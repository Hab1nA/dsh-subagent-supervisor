{
  "name": "dsh-subagent-supervisor",
  "version": "0.5.0",
  "description": "Host-plane subagent supervision tools for the DeepSeek Harness main agent: per-child model/reasoning/Agent-preset overrides, steer/inject delivery, queue management, step-level probing, settlement wait, plus a web supervision panel.",
  "type": "module",
  "main": "lib/index.js",
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-connection"
      ]
    }
  },
  "files": ["lib"],
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "subagent",
    "agent",
    "orchestration",
    "supervision"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Hab1nA/dsh-subagent-supervisor.git"
  },
  "homepage": "https://github.com/Hab1nA/dsh-subagent-supervisor",
  "bugs": {
    "url": "https://github.com/Hab1nA/dsh-subagent-supervisor/issues"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.1.1-rc.2 <0.2.0 || >=0.1.2-alpha.1 <0.2.0",
    "@deepseek-ai/dsh-llm": ">=0.1.1-rc.2 <0.2.0 || >=0.1.2-alpha.1 <0.2.0"
  }
}
